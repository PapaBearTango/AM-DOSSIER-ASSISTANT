<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">

  <Id>9a5a24d2-8f37-4cf8-a95b-32e7589a6401</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Architectural Metals</ProviderName>
  <DefaultLocale>nl-BE</DefaultLocale>

  <DisplayName DefaultValue="AM Dossier Assistant"/>
  <Description
    DefaultValue="Testversie voor het toevoegen van AM-dossiernummers aan e-mailonderwerpen."/>

  <IconUrl
    DefaultValue="https://github.githubassets.com/favicons/favicon.png"/>
  <HighResolutionIconUrl
    DefaultValue="https://github.githubassets.com/favicons/favicon.png"/>

  <SupportUrl
    DefaultValue="https://papabeartango.github.io/AM-DOSSIER-ASSISTANT/"/>

  <AppDomains>
    <AppDomain>https://papabeartango.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="Mailbox"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation
          DefaultValue="https://papabeartango.github.io/AM-DOSSIER-ASSISTANT/index.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs"
          ItemType="Message"
          FormType="Edit"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <FunctionFile resid="Taskpane.Url"/>

          <ExtensionPoint
            xsi:type="MessageComposeCommandSurface">

            <OfficeTab id="TabDefault">
              <Group id="AM.Group">
                <Label resid="Group.Label"/>

                <Control xsi:type="Button"
                         id="AM.OpenAssistant">

                  <Label resid="Button.Label"/>

                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Description"/>
                  </Supertip>

                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>

                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>

                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16"
          DefaultValue="https://github.githubassets.com/favicons/favicon.png"/>
        <bt:Image id="Icon.32"
          DefaultValue="https://github.githubassets.com/favicons/favicon.png"/>
        <bt:Image id="Icon.80"
          DefaultValue="https://github.githubassets.com/favicons/favicon.png"/>
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Taskpane.Url"
          DefaultValue="https://papabeartango.github.io/AM-DOSSIER-ASSISTANT/index.html"/>
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="Group.Label"
          DefaultValue="Architectural Metals"/>
        <bt:String id="Button.Label"
          DefaultValue="AM Dossier Assistant"/>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="Button.Description"
          DefaultValue="Voeg een AM-dossiernummer toe aan het onderwerp van een conceptmail."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
